---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Benchmarks from "../components/Benchmarks.astro";
import Boundary from "../components/Boundary.astro";
import Flow from "../components/Flow.astro";
import Loop from "../components/Loop.astro";
import bench from "../data/bench.json";
import mark from "../assets/mark.svg?raw";
import "../styles/fonts.css";

// The current release, read from the CLI so the install command is never out of date.
const versionFile = readFileSync(join(process.cwd(), "../packages/core/src/version.ts"), "utf8");
const version = /"(\d+\.\d+\.\d+[^"]*)"/.exec(versionFile)?.[1] ?? "latest";
const repo = "https://github.com/ysugarmen/homeostat";
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = `${(Astro.site?.href ?? "https://homeostat-site.sugaryoni3.workers.dev/").replace(/\/$/, "")}${b}`;
const repeated = bench.measures.find((x) => x.name === "coding_repeated_mistake");
const pctOf = (v = 0) => `${Math.round(v * 100)}%`;
const title = "Homeostat: the team knowledge base that maintains itself";
const description = `Coding agents stopped repeating reviewers' corrections: ${pctOf(repeated?.before.mean)} to ${pctOf(repeated?.after.mean)} of tasks. A team knowledge base for coding agents, learned from code review and kept current. Runs on your repos, CI and keys.`;

// One rule as it lives in the knowledge base: a section of a topic file, with its score, source and owner.
const ruleFile = `## Use the shared retry helper for outbound HTTP calls {#outbound-http-retry-helper}

<!-- homeostat
scope: ["services/integrations/**", "packages/http-client/**"]
status: accepted
score: 76
owner: dana
source:
  type: pr-feedback
  url: https://bitbucket.org/acme/integrations-api/pull-requests/812#comment-33
  author: sam
  changedCode: true
created: 2026-09-30
lastConfirmed: 2026-10-07
-->

Wrap every outbound HTTP call to a partner API in withRetry() from
@acme/http-client. Do not hand-roll retry loops.

Why: hand-rolled loops have dropped the request-id header that
on-call searches logs by.`;

const compare = [
  { name: "CLAUDE.md, AGENTS.md", cells: ["Written by hand", "Goes stale silently", "One file per repo", "Whoever edits it last"] },
  { name: "Agent memory", cells: ["Picked up by one person's agent", "Never retired", "One person, one tool", "Nobody reviews it"] },
  { name: "Homeostat", cells: ["Learned from reviews, developers and the code", "Scored, judged, retired when stale", "Every agent on the team", "Pull requests; people decide the middle band"], us: true },
];
const compareRows = ["Where it comes from", "Staying correct", "Who gets it", "Who governs it"];

const lessons = [
  // Default weights: 50 for a comment followed by a fix, 45 by hand, 25 from an agent; +20 lead,
  // +14 senior, +6 member; +8 when it names real code, +4 for a clear title.
  { score: 82, label: "A lead's comment, followed by a fix, naming the code", decision: "merged" },
  { score: 76, label: "A senior's comment, followed by a fix, naming the code", decision: "merged" },
  { score: 60, label: "A member's comment, followed by a fix, naming no code", decision: "review" },
  { score: 55, label: "A rule a member wrote by hand", decision: "review" },
  { score: 29, label: "A note an agent left at the end of a session", decision: "declined" },
];

const spec = [
  ["Changes", "Pull requests only"],
  ["Model reads", "Review threads and the KB. Code only via bootstrap, after a preview"],
  ["Cost", "Reported per run, capped by agents.maxCostUsd"],
  ["Session start", "Under a second, 600 rules"],
  ["Measured", "homeostat bench: plugin off vs on"],
  ["Agents", "Claude Code, any MCP client, Cursor, GitHub Copilot, AGENTS.md"],
  ["License", "Apache-2.0"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Homeostat</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${b}/fonts/archivo.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href={`${b}/`}><span class="mark" set:html={mark} />Homeostat</a>
      <nav aria-label="Main">
        <a href={`${b}/#benchmarks`}>Benchmarks</a>
        <a href={`${b}/docs/`}>Docs</a>
        <a href={`${b}/docs/guide/quickstart/`}>Quickstart</a>
        <a href={`${b}/docs/architecture/`}>Architecture</a>
        <a href={repo} class="gh">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <h1>The team knowledge base that maintains itself.</h1>
          <p class="proof">
            <a href="#benchmarks">Agents stopped repeating reviewers' corrections: <b>{pctOf(repeated?.before.mean)} → {pctOf(repeated?.after.mean)}</b> of tasks.</a>
          </p>
          <p class="lede">
            Your team's conventions, decisions and system docs, in a repo you own. Learned from code review, developers and
            the code; kept current on its own; given to every agent.
          </p>
          <p class="lede own-line">Runs entirely in your CI and your agent sessions, using your own keys. There's no Homeostat backend, so your code and data never reach us.</p>
          <div class="ctas">
            <a class="btn primary" href={`${b}/docs/guide/quickstart/`}>Read the quickstart</a>
            <a class="btn" href={repo}>View on GitHub</a>
          </div>
          <p class="install"><span>In your team's knowledge base repo:</span><code>npx --yes homeostat@{version} setup</code></p>
        </div>
        <div class="hero-visual">
          <Loop />
        </div>
      </section>

      <section class="steps" aria-labelledby="how">
        <h2 id="how">How it works</h2>
        <Flow />
      </section>

      <Benchmarks />

      <section class="scale" aria-labelledby="confidence">
        <div class="scale-head">
          <h2 id="confidence">Humans decide only the middle band</h2>
          <p>Every change is scored. Only the middle band waits for a person. The lines are yours to move.</p>
        </div>
        <div class="bars" role="list">
          {lessons.map((l) => (
            <div class="bar-row" role="listitem">
              <span class="bar-label">{l.label}</span>
              <span class="bar-track">
                <span class={`bar ${l.decision}`} style={`--w:${l.score}%`}></span>
                <span class="line l35" aria-hidden="true"></span>
                <span class="line l70" aria-hidden="true"></span>
              </span>
              <span class={`bar-value ${l.decision}`}>{l.score} <small>{l.decision}</small></span>
            </div>
          ))}
          <div class="bar-row axis" aria-hidden="true">
            <span></span>
            <span class="bar-track bare"><span style="left:35%">35</span><span style="left:70%">70</span><span style="left:100%">100</span></span>
            <span></span>
          </div>
        </div>
      </section>

      <section class="knows" aria-labelledby="knows">
        <h2 id="knows">What the knowledge looks like</h2>
        <div class="knows-grid">
          <div>
            <p class="knows-lede">Markdown in your repo. Every rule keeps its score, the review it came from and its owner.</p>
            <pre class="rule-file"><code>{ruleFile}</code></pre>
          </div>
          <div>
            <h3 class="cmp-title">Why not just CLAUDE.md or agent memory?</h3>
            <div class="cmp" role="table">
              <div class="cmp-row head" role="row">
                <span role="columnheader"></span>
                {compare.map((c) => <span role="columnheader" class={c.us ? "us" : ""}>{c.name}</span>)}
              </div>
              {compareRows.map((r, i) => (
                <div class="cmp-row" role="row">
                  <span role="rowheader" class="rh">{r}</span>
                  {compare.map((c) => <span role="cell" class={c.us ? "us" : ""}>{c.cells[i]}</span>)}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="plate" aria-labelledby="own">
        <h2 id="own">Runs on yours, not ours</h2>
        <Boundary />
        <p class="plate-note">
          What is sent where, and how to turn each part off: <a href={`${b}/docs/data-handling/`}>data handling</a>. Who can change
          what your agents are told: <a href={`${b}/docs/security/`}>security</a>.
        </p>
      </section>

      <section class="plate" aria-labelledby="spec">
        <h2 id="spec">Specifications</h2>
        <dl>
          {spec.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="setup" aria-labelledby="start">
        <h2 id="start">Ten minutes to a first daily run</h2>
        <div class="setup-grid">
          <div>
            <p class="setup-step">In your team's knowledge base repo, one guided setup: tokens, repos, team, schedules, Slack</p>
            <pre><code>npx --yes homeostat@{version} setup</code></pre>
          </div>
          <div>
            <p class="setup-step">Each teammate, once: the Claude Code plugin, pointed at the knowledge base</p>
            <pre><code>npx --yes homeostat@{version} setup --join</code></pre>
          </div>
          <div>
            <p class="setup-step">Any time after: what's done, what's missing, what's optional</p>
            <pre><code>npx --yes homeostat@{version} setup --check</code></pre>
          </div>
        </div>
        <div class="ctas">
          <a class="btn primary" href={`${b}/docs/guide/setup/`}>Read the setup guide</a>
          <a class="btn" href={`${b}/docs/guide/team/`}>How a team uses it</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>
        Named after W. Ross Ashby's homeostat of 1948: four units that kept one another in balance.
      </p>
      <p class="foot-links">
        <a href={`${b}/docs/`}>Docs</a><a href={repo}>GitHub</a><a href={`${b}/docs/security/`}>Security</a><span>Apache-2.0</span>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #121a21;
    --panel: #18222b;
    --line: #2b3843;
    --paper: #eae4d6;
    --muted: #b3bbc2;
    --faint: #7d8993;
    --amber: #f0a541;
    --teal: #6cc4a8;
    --gold: #d8b25a;
    --coral: #d9705c;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; background: var(--ink); }
  body {
    margin: 0;
    background:
      radial-gradient(60% 40% at 85% -5%, rgb(240 165 65 / 0.07), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.018) 1px, transparent 1px) 0 0 / 100% 32px,
      var(--ink);
    color: var(--paper);
    font-family: "IBM Plex Sans", ui-sans-serif, sans-serif;
    font-size: 17px;
    line-height: 1.6;
  }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 12px; background: var(--panel); padding: 6px 10px; z-index: 10; }
  code { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.88em; }
  h1, h2, h3 { font-family: "Archivo", sans-serif; color: var(--paper); margin: 0; }
  h2 { font-stretch: 112%; font-weight: 800; font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -0.015em; line-height: 1.15; }
  h3 { font-stretch: 105%; font-weight: 700; font-size: 1.08rem; }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: "Archivo", sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.1rem;
  }
  .mark { display: inline-flex; }
  .mark svg { width: 28px; height: 28px; display: block; }
  .nav nav { display: flex; gap: 22px; margin-left: auto; font-size: 0.95rem; }
  .nav nav a { text-decoration: none; color: var(--muted); }
  .nav nav a:hover { color: var(--paper); }

  main { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 44px;
    align-items: center;
    padding: 56px 0 96px;
  }
  .hero h1 {
    font-stretch: 125%;
    font-weight: 850;
    font-size: clamp(2.1rem, 3.5vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: none;
  }
  .proof { margin: 18px 0 0; font-size: 1.05rem; }
  .proof a { color: var(--teal); text-decoration: none; border-bottom: 1px dashed rgb(108 196 168 / 0.5); }
  .proof b { font-family: "JetBrains Mono", monospace; font-weight: 700; }

  .knows { padding: 80px 0 72px; border-top: 1px solid var(--line); }
  .knows-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; margin-top: 28px; align-items: start; }
  .knows-lede { color: var(--muted); margin: 0 0 14px; }
  .rule-file { margin: 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); white-space: pre-wrap; overflow-wrap: anywhere; font: 0.78rem/1.6 "JetBrains Mono", monospace; color: var(--paper); }
  .cmp-title { margin: 0 0 14px; font-size: 1.05rem; }
  .cmp { display: grid; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; font-size: 0.86rem; }
  .cmp-row { display: grid; grid-template-columns: 8.5em repeat(3, minmax(0, 1fr)); }
  .cmp-row > span { padding: 11px 12px; border-top: 1px solid var(--line); color: var(--muted); }
  .cmp-row.head > span { border-top: 0; color: var(--paper); font-weight: 600; font-size: 0.82rem; }
  .cmp-row .rh { color: var(--faint); font-size: 0.8rem; }
  .cmp-row .us { background: rgb(108 196 168 / 0.07); color: var(--paper); }
  .cmp-row.head .us { color: var(--teal); }
  .lede { color: var(--muted); font-size: 1.12rem; max-width: 34em; margin: 24px 0 32px; }
  .lede.own-line { margin-top: -16px; color: var(--paper); font-size: 1rem; border-left: 2px solid var(--teal); padding-left: 12px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    transition: border-color 150ms, background 150ms;
  }
  .btn:hover { border-color: var(--faint); }
  .btn.primary { background: var(--amber); border-color: var(--amber); color: #1b1307; }
  .btn.primary:hover { background: #f6b85f; }
  .install { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; color: var(--faint); font-size: 0.88rem; }
  .install code { color: var(--paper); background: var(--panel); border: 1px solid var(--line); padding: 4px 10px; border-radius: 6px; }

  .steps { padding: 32px 0 96px; border-top: 1px solid var(--line); }
  .steps h2 { margin: 48px 0 36px; }

  .scale { padding: 80px 0 96px; border-top: 1px solid var(--line); display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; }
  .scale-head p { color: var(--muted); margin: 20px 0 0; }
  .scale-head code { color: var(--paper); }
  .bars { display: grid; gap: 18px; align-self: center; }
  .bar-row { display: grid; grid-template-columns: minmax(0, 15em) minmax(0, 1fr) 7.5em; gap: 16px; align-items: center; }
  .bar-label { color: var(--muted); font-size: 0.9rem; line-height: 1.35; }
  .bar-track { position: relative; height: 12px; background: rgb(255 255 255 / 0.03); border-radius: 3px; }
  .bar { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: 3px; }
  .bar.merged { background: var(--teal); }
  .bar.review { background: var(--gold); }
  .bar.declined { background: var(--coral); }
  .line { position: absolute; top: -5px; bottom: -5px; width: 1px; background: var(--paper); opacity: 0.45; }
  .l35 { left: 35%; }
  .l70 { left: 70%; }
  .bar-value { font-family: "Archivo", sans-serif; font-stretch: 112%; font-weight: 800; font-variant-numeric: tabular-nums; }
  .bar-value small { font-family: "IBM Plex Sans", sans-serif; font-weight: 500; font-size: 0.78rem; margin-left: 4px; }
  .bar-value.merged small { color: var(--teal); }
  .bar-value.review small { color: var(--gold); }
  .bar-value.declined small { color: var(--coral); }
  .bar-row.axis { margin-top: -10px; }
  .bar-track.bare { background: none; height: 1.2em; color: var(--faint); font-size: 0.75rem; }
  .bar-track.bare span { position: absolute; transform: translateX(-50%); }

  .plate {
    margin: 0 0 96px;
    padding: 40px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%), var(--panel);
  }
  .plate dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; margin: 28px 0 0; }
  .plate dl div { display: grid; grid-template-columns: 11em minmax(0, 1fr); gap: 16px; padding: 14px 0; border-top: 1px solid var(--line); }
  .plate dt { color: var(--faint); font-size: 0.9rem; }
  .plate dd { margin: 0; color: var(--paper); font-size: 0.95rem; }
  .plate-note { margin: 24px 0 0; color: var(--faint); font-size: 0.9rem; }
  .plate-note a { color: var(--amber); }

  .setup { padding: 0 0 112px; }
  .setup-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 32px 0; }
  .setup-step { margin: 0 0 8px; color: var(--muted); font-size: 0.92rem; }
  .setup pre {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    color: var(--paper);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .foot {
    width: min(1152px, calc(100% - 48px));
    margin: 0 auto;
    padding: 32px 0 48px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    color: var(--faint);
    font-size: 0.88rem;
  }
  .foot p { margin: 0; }
  .foot-links { display: flex; gap: 20px; }
  .foot-links a { text-decoration: none; }
  .foot-links a:hover { color: var(--paper); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 32px; }
    .scale { grid-template-columns: minmax(0, 1fr); }
    .plate dl { grid-template-columns: 1fr; }
    .setup-grid { grid-template-columns: 1fr; }
    .knows-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    body { font-size: 16px; }
    .nav { padding: 16px; gap: 12px; }
    .nav nav { gap: 14px; font-size: 0.88rem; }
    .nav nav a:not(.gh):nth-child(n + 2) { display: none; }
    main { padding: 0 16px; }
    .bar-row { grid-template-columns: minmax(0, 1fr) 6.5em; }
    .bar-label { grid-column: 1 / -1; }
    .bar-row.axis { display: none; }
    .plate { padding: 24px 18px; }
    .plate dl div { grid-template-columns: 1fr; gap: 4px; }
    .foot { width: calc(100% - 32px); }
    .steps { padding: 8px 0 48px; }
    .steps h2 { margin: 32px 0 20px; }
    .knows { padding: 56px 0 48px; }
    .cmp { font-size: 0.78rem; }
    .cmp-row { grid-template-columns: 6em repeat(3, minmax(0, 1fr)); }
    .cmp-row > span { padding: 9px 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
