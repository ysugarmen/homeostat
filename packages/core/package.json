{
  "name": "@homeostat/core",
  "version": "0.1.10",
  "description": "Schemas, validation, scoring and agents behind homeostat, the team knowledge base for coding agents.",
  "keywords": [
    "homeostat",
    "knowledge-base",
    "coding-rules"
  ],
  "homepage": "https://github.com/ysugarmen/homeostat#readme",
  "bugs": {
    "url": "https://github.com/ysugarmen/homeostat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysugarmen/homeostat.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Yonatan Sugarmen",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/providers/replay.ts"
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.tsbuildinfo",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "js-tiktoken": "^1.0.21",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/vertex-sdk": "^0.20.4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    },
    "@anthropic-ai/vertex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/vertex-sdk": "^0.20.4"
  },
  "scripts": {
    "gen:schema": "node scripts/gen-schema.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
