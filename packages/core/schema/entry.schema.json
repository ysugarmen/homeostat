{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "disputed", "retired"]
    },
    "score": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["pr-feedback", "manual", "agent-handoff", "deep-dive"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "changedCode": {
          "type": "boolean"
        }
      },
      "required": ["type", "author"],
      "additionalProperties": false
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastConfirmed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "riskReviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "convention",
        "anti-pattern",
        "review-lesson",
        "migration",
        "legacy",
        "tech-debt",
        "practice",
        "decision"
      ]
    },
    "adopted": {
      "type": "boolean"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["by", "reason", "date"],
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "area",
    "scope",
    "status",
    "score",
    "owner",
    "source",
    "created",
    "lastConfirmed",
    "tokens"
  ],
  "additionalProperties": false,
  "title": "homeostat knowledge entry frontmatter",
  "description": "Shape only. Cross-field rules (pr-feedback needs source.url, conflictsWith forces disputed) and config rules are enforced by `homeostat validate`."
}
