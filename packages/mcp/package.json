{
  "name": "@homeostat/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing a Homeostat knowledge base to any agent.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@homeostat/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysugarmen/homeostat.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
